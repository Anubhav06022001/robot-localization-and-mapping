<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="corridor_world">

    <!-- Physics -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <!-- Sun -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 10</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 10</size>
            </plane>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Left wall: 20 m long -->
    <model name="left_wall">
      <static>true</static>
      <pose>0 2 1</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>20 0.2 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>20 0.2 2</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Right wall: 20 m long -->
    <model name="right_wall">
      <static>true</static>
      <pose>0 -2 1</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>20 0.2 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>20 0.2 2</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

        <!-- Moving wall panel at corridor midpoint -->
    <include>
      <uri>model://moving_wall</uri>
      <name>moving_wall</name>
      <pose>0 0 1.5 0 0 0</pose>
    </include>


  </world>
</sdf>
